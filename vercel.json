{
  "rewrites": [
    {
      "source": "/menu/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": ".*([Ww][Hh][Aa][Tt][Ss][Aa][Pp][Pp]|[Ff][Aa][Cc][Ee][Bb][Oo][Oo][Kk][Ee][Xx][Tt][Ee][Rr][Nn][Aa][Ll][Hh][Ii][Tt]|[Ff][Aa][Cc][Ee][Bb][Oo][Tt]|[Tt][Ww][Ii][Tt][Tt][Ee][Rr][Bb][Oo][Tt]|[Tt][Ee][Ll][Ee][Gg][Rr][Aa][Mm][Bb][Oo][Tt]|[Ss][Ll][Aa][Cc][Kk][Bb][Oo][Tt]|[Dd][Ii][Ss][Cc][Oo][Rr][Dd][Bb][Oo][Tt]|[Ll][Ii][Nn][Kk][Ee][Dd][Ii][Nn][Bb][Oo][Tt]|[Pp][Ii][Nn][Tt][Ee][Rr][eE][sS][tT]|[Gg][Oo][oO][gG][lL][eE][bB][oO][tT]).*"
          }
        }
      ],
      "destination": "/api/menu-share?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "menuhub-one.vercel.app"
        }
      ],
      "destination": "https://fb3d2ymenu.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "menuhub-fb3d2y.vercel.app"
        }
      ],
      "destination": "https://fb3d2ymenu.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "menuhub-git-main-fb3d2y.vercel.app"
        }
      ],
      "destination": "https://fb3d2ymenu.com.br/:path*",
      "permanent": true
    }
  ]
}
