{
  "rewrites": [
    {
      "source": "/menu/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|whatsapp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|Discordbot|LinkedInBot|Pinterest|Googlebot).*"
        }
      ],
      "destination": "/api/menu-share?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "menuhub-one.vercel.app"
        }
      ],
      "destination": "https://fb3d2ymenu.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "menuhub-fb3d2y.vercel.app"
        }
      ],
      "destination": "https://fb3d2ymenu.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "menuhub-git-main-fb3d2y.vercel.app"
        }
      ],
      "destination": "https://fb3d2ymenu.com.br/:path*",
      "permanent": true
    }
  ]
}
